<?xml version="1.0" encoding="utf-8"?>
<!--
  3D Modeler Windows installer (WiX Toolset 5).

  Per-user install: no administrator rights, installs to
  %LOCALAPPDATA%\Programs\Modeler3D (kept apart from %LOCALAPPDATA%\Modeler3D,
  which holds the app's settings). Build with packaging/msi/Build-Msi.ps1.

  StageDir   = staged app layout (exe, assets/original, licenses)
  CrtDir     = MSVC redist Microsoft.VC143.CRT folder (app-local runtime)
  Version    = MSI version; bump the third field for every new candidate so
               it upgrades the previous one in place.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="3D Modeler"
           Manufacturer="3D Modeler"
           Version="$(var.Version)"
           UpgradeCode="5265867e-ffb4-4651-bcce-43332be7d249"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of 3D Modeler is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="Modeler3D.ico" SourceFile="$(var.StageDir)\assets\original\Modeler3D.ico" />
    <Property Id="ARPPRODUCTICON" Value="Modeler3D.ico" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch 3D Modeler" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#Modeler3DExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Modeler3D" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="Modeler3DExe" Source="$(var.StageDir)\Modeler3D.exe" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
      <Files Include="$(var.StageDir)\**">
        <Exclude Files="$(var.StageDir)\Modeler3D.exe" />
      </Files>
      <Component Id="VcRuntimeMsvcp">
        <File Source="$(var.CrtDir)\msvcp140.dll" />
      </Component>
      <Component Id="VcRuntimeCore">
        <File Source="$(var.CrtDir)\vcruntime140.dll" />
      </Component>
      <Component Id="VcRuntimeCore1">
        <File Source="$(var.CrtDir)\vcruntime140_1.dll" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuModeler3D" Name="3D Modeler"
                Target="[#Modeler3DExe]" WorkingDirectory="INSTALLFOLDER"
                Icon="Modeler3D.ico" />
      <RegistryValue Root="HKCU" Key="Software\Modeler3D\Installer"
                     Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="DesktopModeler3D" Name="3D Modeler"
                Target="[#Modeler3DExe]" WorkingDirectory="INSTALLFOLDER"
                Icon="Modeler3D.ico" />
      <RegistryValue Root="HKCU" Key="Software\Modeler3D\Installer"
                     Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
